APP_DOMAIN=lotto.mintwool.com
APP_ORIGIN=https://lotto.mintwool.com
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backups
BOOTSTRAP_USERNAME=textimage
# Generate with npm run setup:admin. Never place the plain password here.
BOOTSTRAP_PASSWORD_HASH=
# Enable only on one always-running server. Keep disabled on local development.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Empty uses BOOTSTRAP_USERNAME (or textimage).
TELEGRAM_SITE_USERNAME=
